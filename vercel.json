{
    "version": 2,
    "rewrites": [
        {
            "source": "/chat",
            "destination": "/index.html"
        },
        {
            "source": "/voice",
            "destination": "/voice_chat.html"
        },
        {
            "source": "/help",
            "destination": "/help.html"
        },
        {
            "source": "/about",
            "destination": "/about.html"
        },
        {
            "source": "/api/v1/(.*)",
            "destination": "/api/index"
        },
        {
            "source": "/health",
            "destination": "/api/index"
        },
        {
            "source": "/conversation",
            "destination": "/api/index"
        },
        {
            "source": "/llm/(.*)",
            "destination": "/api/index"
        },
        {
            "source": "/docs",
            "destination": "/api/index"
        },
        {
            "source": "/openapi.json",
            "destination": "/api/index"
        }
    ]
}